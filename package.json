{
  "name": "@picketai/picket",
  "version": "1.0.0-alpha.1",
  "description": "Picket: a software-development workflow for Claude Code with four lanes, four agents and one kernel.",
  "homepage": "https://github.com/picketai/picket#readme",
  "bugs": {
    "url": "https://github.com/picketai/picket/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/picketai/picket.git"
  },
  "license": "MIT",
  "author": "Vlad Apetre",
  "type": "commonjs",
  "bin": {
    "picket": "core/bin/picket.mjs"
  },
  "files": [
    "core/",
    ".claude-plugin/marketplace.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "version": "node .github/scripts/release.mjs sync-version && git add core/.claude-plugin/plugin.json",
    "opensrc": "set \"OPENSRC_HOME=%cd%\\.opensrc\" && opensrc",
    "bench:test": "node --test bench/test/",
    "bench:integration": "node --test bench/integration/",
    "bench:dry": "node bench/run.mjs --dry --harness plugin",
    "bench:report": "node bench/report.mjs",
    "picket": "node core/bin/picket.mjs",
    "claude": "claude --plugin-dir core"
  },
  "devDependencies": {
    "opensrc": "^0.7.2"
  }
}
