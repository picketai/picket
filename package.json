{
  "name": "@picketai/picket",
  "version": "1.0.0-alpha.3",
  "description": "Picket: a software-development workflow for Claude Code with four lanes, four agents and one kernel.",
  "homepage": "https://github.com/picketai/picket#readme",
  "bugs": {
    "url": "https://github.com/picketai/picket/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/picketai/picket.git"
  },
  "license": "MIT",
  "author": "Vlad Apetre",
  "type": "commonjs",
  "bin": {
    "picket": "dist/bin/picket.mjs"
  },
  "files": [
    "dist/",
    ".claude-plugin/marketplace.json",
    "status/.claude-plugin/plugin.json",
    "status/hooks/",
    "status/types/",
    "session/.claude-plugin/plugin.json",
    "session/hooks/",
    "session/types/",
    "markdown/.claude-plugin/plugin.json",
    "markdown/hooks/",
    "markdown/types/",
    "LICENSE",
    "README.md",
    "!**/*.test.*"
  ],
  "imports": {
    "#test/*": "./test/support/*"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/watch.mjs",
    "typecheck": "tsc -p .",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "npm run typecheck && node scripts/test.mjs",
    "test:unit": "node --test \"src/**/*.test.mts\"",
    "version": "node .github/scripts/release.mjs sync-version && git add src/.claude-plugin/plugin.json status/.claude-plugin/plugin.json session/.claude-plugin/plugin.json markdown/.claude-plugin/plugin.json",
    "test:status": "claude plugin validate --strict status && claude plugin test status",
    "test:session": "claude plugin validate --strict session && claude plugin test session",
    "test:markdown": "claude plugin validate --strict markdown && claude plugin test markdown",
    "opensrc": "set \"OPENSRC_HOME=%cd%\\.opensrc\" && opensrc",
    "bench:test": "node --test bench/test/",
    "bench:integration": "node --test bench/integration/",
    "bench:dry": "node bench/run.mjs --dry --harness plugin",
    "bench:report": "node bench/report.mjs",
    "picket": "node dist/bin/picket.mjs",
    "claude": "npm run build && node scripts/claude.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "opensrc": "^0.7.2",
    "typescript": "7.0.2"
  }
}
