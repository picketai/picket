{
  "name": "@picketai/picket",
  "version": "1.0.0-alpha.3",
  "description": "Picket: a software-development workflow for Claude Code with four lanes, four agents and one kernel.",
  "homepage": "https://github.com/picketai/picket#readme",
  "bugs": {
    "url": "https://github.com/picketai/picket/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/picketai/picket.git"
  },
  "license": "MIT",
  "author": "Vlad Apetre",
  "type": "module",
  "bin": {
    "picket": "dist/bin/picket.mjs"
  },
  "files": [
    "dist/",
    ".claude-plugin/marketplace.json",
    "LICENSE",
    "README.md",
    "!**/*.test.*"
  ],
  "imports": {
    "#test/*": "./test/support/*"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/watch.mjs",
    "docs": "node scripts/docs.mjs",
    "typecheck": "tsc -p .",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "npm run typecheck && node scripts/test.mjs",
    "test:unit": "node --test \"src/**/*.test.mts\"",
    "version": "node .github/scripts/release.mjs sync-version && git add src/.claude-plugin/plugin.json",
    "test:status": "claude plugin validate --strict dist/mods/status && claude plugin test dist/mods/status",
    "test:markdown": "claude plugin validate --strict dist/mods/markdown && claude plugin test dist/mods/markdown",
    "test:session": "claude plugin validate --strict dist/mods/session && claude plugin test dist/mods/session",
    "bench:test": "node --test \"bench/test/*.test.mjs\"",
    "bench:integration": "node --test \"bench/integration/*.test.mjs\"",
    "bench:dry": "node bench/run.mjs --dry --harness plugin",
    "bench:report": "node bench/report.mjs",
    "picket": "node dist/bin/picket.mjs",
    "claude": "npm run build && node scripts/claude.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
