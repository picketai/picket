{
  "hooks": {
    "SessionStart": [{ "hooks": [
      { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/session.mjs"] },
      { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject-size.mjs", "SA"] },
      { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject-size.mjs", "SB"] }
    ] }],
    "SubagentStart": [{ "hooks": [
      { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/subagent.mjs"] },
      { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject-size.mjs", "AA"] },
      { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject-size.mjs", "AB"] }
    ] }],
    "PreToolUse": [{ "matcher": "Write|Edit", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs"] }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/stop.mjs"] }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/stop.mjs"] }] }]
  }
}
