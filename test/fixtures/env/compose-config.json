{
  "name": "env",
  "services": {
    "billing-db-client": {
      "profiles": ["picket-data"],
      "command": ["/opt/mssql-tools/bin/sqlcmd", "-?"],
      "image": "mcr.microsoft.com/mssql-tools:latest@sha256:62556500522072535cb3df2bb5965333dded9be47000473e9e0f84118e248642",
      "labels": { "io.github.picketai.role": "data" },
      "networks": { "default": null }
    },
    "cache": {
      "healthcheck": { "test": ["CMD", "redis-cli", "ping"], "timeout": "2s", "interval": "2s", "retries": 15 },
      "image": "redis:7.4-alpine@sha256:7f7d30b7fdd09467bac58198a1f166dd69789d348d4fe859cccb20e0cf287fbe",
      "labels": { "io.github.picketai.role": "dependency" },
      "networks": { "default": null }
    },
    "orders": {
      "build": { "context": "/umbrella/services/orders", "dockerfile": "../../.picket/env/docker/orders/Dockerfile" },
      "depends_on": {
        "cache": { "condition": "service_healthy", "required": true },
        "orders-seed": { "condition": "service_completed_successfully", "required": true },
        "payments-mock": { "condition": "service_healthy", "required": true }
      },
      "environment": { "PAYMENTS_URL": "http://payments-mock:8080" },
      "healthcheck": { "test": ["CMD", "wget", "-q", "-O", "-", "http://127.0.0.1:8080/health"], "timeout": "2s", "interval": "2s", "retries": 15 },
      "labels": { "io.github.picketai.role": "app" },
      "networks": { "default": null },
      "ports": [{ "mode": "ingress", "target": 8080, "protocol": "tcp" }],
      "volumes": [{ "type": "volume", "source": "orders-data", "target": "/data", "volume": {} }]
    },
    "orders-seed": {
      "command": ["sh", "-c", "echo '[{\"id\":1,\"item\":\"seed\"}]' > /data/orders.json"],
      "image": "busybox:1.36@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662",
      "labels": { "io.github.picketai.role": "seed" },
      "networks": { "default": null },
      "volumes": [{ "type": "volume", "source": "orders-data", "target": "/data", "volume": {} }]
    },
    "payments-mock": {
      "command": ["sh", "-c", "mkdir -p /www && echo ok > /www/health && httpd -f -p 8080 -h /www"],
      "healthcheck": { "test": ["CMD", "wget", "-q", "-O", "-", "http://127.0.0.1:8080/health"], "timeout": "2s", "interval": "2s", "retries": 15 },
      "image": "busybox:1.36@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662",
      "labels": { "io.github.picketai.role": "mock" },
      "networks": { "default": null },
      "ports": [{ "mode": "ingress", "target": 8080, "protocol": "tcp" }]
    }
  },
  "networks": { "default": { "name": "env_default", "ipam": {} } },
  "volumes": { "orders-data": { "name": "env_orders-data" } },
  "x-picket": { "version": 1, "shared": { "legacy": { "address": "PICKET_SHARED_LEGACY" } } }
}
