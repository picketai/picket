.opensrc/*


artifacts/sessions/.map/
artifacts/sessions/*

# session telemetry (generated by hooks/emit.metrics.mjs; analyse with telemetry/report.mjs)
.claude/telemetry/ledger.jsonl
# guard.bash decision trace (generated by hooks/guard.bash.mjs)
.claude/telemetry/guard-bash.log
# drive evidence (generated by hooks/observe.bash.mjs; read by guard.verdict.mjs)
.claude/state/

# benchmark scratch (fixture template with node_modules, per-run repos, spend log)
bench/.cache/
bench/.runs/
bench/results/spend.log
bench/fixture/node_modules/
bench/results/smoke*.json

# harness ledger (hooks write it; harness cost reads it)
.claude/ledger/
.picket/state/
bench/results/probe*.json

# per-feature worktrees and the branching manifest (machine-local)
.worktrees/
.claude/branching/

# source snapshots: copies of an external repo's documents; sources.yaml with their hashes is
# committed (committing the bytes is OQ-002 of 20261001-external-sources-and-traced-cumulative-review)
work/*/sources/

# per-machine Claude Code settings; may carry secrets such as AZDO_PAT in its env block
.claude/settings.local.json

tmp/

status/tsconfig.json
session/tsconfig.json
markdown/tsconfig.json

