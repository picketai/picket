{
  "hooks": {
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject.state.mjs"] },
        { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject.rules.mjs"] },
        { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject.extensions.mjs"] }
      ] }
    ],
    "SubagentStart": [
      { "hooks": [
        { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject.rules.mjs"] },
        { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject.extensions.mjs"] }
      ] }
    ],
    "PreToolUse": [
      { "matcher": "Write|Edit", "hooks": [
        { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.scope.mjs"] },
        { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.comments.mjs"] },
        { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.silenced.mjs"] }
      ] },
      { "matcher": "Bash|PowerShell", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.bash.mjs"] }] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/lint.schema.mjs"] }] },
      { "matcher": "Bash|PowerShell", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/observe.drive.mjs"] }] },
      { "matcher": "Read|Grep|Glob|WebFetch|WebSearch", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/monitor.context.mjs"] }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Bash|PowerShell", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/observe.drive.mjs"] }] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.block.mjs"] },
        { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/route.verdict.mjs"] },
        { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/emit.ledger.mjs"] }
      ] }
    ],
    "SubagentStop": [
      { "hooks": [
        { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.block.mjs"] },
        { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/route.verdict.mjs"] },
        { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/emit.ledger.mjs"] }
      ] }
    ],
    "Notification": [
      { "matcher": "permission_prompt|idle_prompt", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/notify.user.mjs"] }] }
    ]
  }
}
