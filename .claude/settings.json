{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest --config .claude/ccstatusline.json"
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(node .claude/bin/harness.mjs*)",
      "Bash(node .claude/scripts/*)",
      "Bash(node .claude/skills/documenting/scripts/*)",
      "Bash(node bench/*)",
      "Bash(npm test*)",
      "Bash(npm run *)",
      "Bash(npx vitest*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git worktree list*)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git branch*)",
      "Bash(git worktree add*)",
      "Bash(git worktree remove*)",
      "Bash(git submodule*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/inject.state.mjs"] },
        { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/inject.rules.mjs"] }
      ] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/inject.rules.mjs"] }] }
    ],
    "PreToolUse": [
      { "matcher": "Write|Edit", "hooks": [
        { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.scope.mjs"] },
        { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.comments.mjs"] }
      ] },
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.bash.mjs"] }] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/lint.schema.mjs"] }] },
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/observe.drive.mjs"] }] },
      { "matcher": "Read|Grep|Glob|WebFetch|WebSearch", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/monitor.context.mjs"] }] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.block.mjs"] },
        { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/route.verdict.mjs"] },
        { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/emit.ledger.mjs"] }
      ] }
    ],
    "SubagentStop": [
      { "hooks": [
        { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.block.mjs"] },
        { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/route.verdict.mjs"] },
        { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/emit.ledger.mjs"] }
      ] }
    ]
  },
  "outputStyle": "custom",
  "disableClaudeAiConnectors": true
}
