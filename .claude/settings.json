{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(picket *)",
      "Bash(node .claude/scripts/*)",
      "Bash(node bench/*)",
      "Bash(npm test*)",
      "Bash(npm run *)",
      "Bash(npx vitest*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git worktree list*)",
      "PowerShell(picket *)",
      "Read(~/.claude/plugins/cache/picketai/**)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git branch*)",
      "Bash(git worktree add*)",
      "Bash(git worktree remove*)",
      "Bash(git submodule*)",
      "PowerShell(picket drive *)",
      "PowerShell(picket check *)"
    ]
  },
  "disableClaudeAiConnectors": true,
  "enabledPlugins": {
    "picket@picketai": true,
    "picket-status@picketai": true
  },
  "outputStyle": "picket:custom"
}
